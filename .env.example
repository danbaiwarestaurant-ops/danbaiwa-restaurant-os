# =====================================================================
# DANBAIWA RESTAURANT POS — SUPABASE CLOUD AUTH & OUTBOX CONFIGURATION
# =====================================================================

# Paste your Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Paste your Supabase Anon / Public Key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Where Supabase email links (password reset, email confirmation) should open.
#
# Optional. Leave it unset and the app uses the page the operator is looking at.
# Set it when the till is reached at an address that differs from the one that should
# receive the link (a kiosk shortcut, a LAN IP that moves).
#
# IMPORTANT: whichever URL ends up being used must ALSO be listed in the Supabase
# dashboard under Authentication > URL Configuration > Redirect URLs. Supabase silently
# replaces any URL that is not on that list with the project's Site URL — which is why
# reset links open the Vercel deployment instead of the till.
# VITE_AUTH_REDIRECT_URL=http://localhost:5173
