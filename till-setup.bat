@echo off
:: ???????????????????????????????????????????????????????????????????????????
:: Danbaiwa Restaurant OS ? Till Machine One-Time Setup
:: ???????????????????????????????????????????????????????????????????????????
:: Run this ONCE on each till machine after cloning / copying the project.
:: It installs the print server as a Windows Task Scheduler job that starts
:: automatically at boot ? no Node window, no staff interaction required.
:: ???????????????????????????????????????????????????????????????????????????

title Danbaiwa POS ? Till Setup

:: Must run as Administrator
net session >nul 2>&1
if %errorLevel% neq 0 (
  echo ERROR: Please right-click this file and choose "Run as administrator".
  pause
  exit /b 1
)

set INSTALL_DIR=%~dp0
set VERCEL_URL=https://danbaiwa-restaurant-os.vercel.app
set PRINTER_NAME=POS-58 11.3.0.1

echo.
echo  Danbaiwa Restaurant OS ? Till Setup
echo  ?????????????????????????????????????????????????????????
echo  Install dir : %INSTALL_DIR%
echo  Vercel URL  : %VERCEL_URL%
echo  Printer     : %PRINTER_NAME%
echo  ?????????????????????????????????????????????????????????
echo.

:: ?? Step 1: Check Node.js is installed ????????????????????????????????????
echo [1/4] Checking Node.js...
node --version >nul 2>&1
if %errorLevel% neq 0 (
  echo ERROR: Node.js is not installed.
  echo Please download and install Node.js from https://nodejs.org
  echo Then re-run this setup script.
  pause
  exit /b 1
)
echo        OK ? %errorLevel%

:: ?? Step 2: Install npm dependencies ??????????????????????????????????????
echo [2/4] Installing dependencies...
cd /d "%INSTALL_DIR%"
call npm install --omit=dev
if %errorLevel% neq 0 (
  echo ERROR: npm install failed.
  pause
  exit /b 1
)

:: ?? Step 3: Install Playwright's Chromium browser ?????????????????????????
echo [3/4] Installing Playwright Chromium...
call npx playwright install chromium
if %errorLevel% neq 0 (
  echo WARNING: Playwright install had issues. Printing may not work.
)

:: ?? Step 4: Register Windows Scheduled Task (runs at boot, as SYSTEM) ?????
echo [4/4] Registering print server as a startup task...

:: Delete old task if it exists
schtasks /delete /tn "DanbaiwaRestaurantOS_PrintServer" /f >nul 2>&1

:: Create the task ? runs at system startup, hidden, with env vars for printer + Vercel URL
schtasks /create ^
  /tn "DanbaiwaRestaurantOS_PrintServer" ^
  /tr "cmd /c \"set PRINT_PRINTER=%PRINTER_NAME%&& set VERCEL_URL=%VERCEL_URL%&& node \"%INSTALL_DIR%print-server.cjs\"\"" ^
  /sc ONSTART ^
  /ru SYSTEM ^
  /rl HIGHEST ^
  /f ^
  /delay 0000:30

if %errorLevel% neq 0 (
  echo ERROR: Could not register startup task.
  pause
  exit /b 1
)

echo.
echo  ???????????????????????????????????????????????????????????
echo  Setup complete!
echo.
echo  The print server will now start automatically at every boot.
echo  To test it now, run:  node print-server.cjs
echo  Then open %VERCEL_URL% in Chrome and print a ticket.
echo  ???????????????????????????????????????????????????????????
echo.
pause
