@echo off
:: ???????????????????????????????????????????????????????????????????????????
:: Danbaiwa Restaurant OS ? Vercel Kiosk Launcher
:: ???????????????????????????????????????????????????????????????????????????
:: Double-click this shortcut to launch the POS till.
:: No Node.js. No local server. No code. Just Chrome + Vercel.
::
:: IMPORTANT: Chrome MUST be killed first ? --kiosk-printing is ignored
:: if Chrome is already running (the new window joins the old process
:: which was not launched with the flag).
:: ???????????????????????????????????????????????????????????????????????????

title Danbaiwa Restaurant POS

:: Step 1: Kill any existing Chrome processes
echo Closing Chrome...
taskkill /F /IM chrome.exe >nul 2>&1
timeout /t 2 /nobreak >nul

:: Step 2: Launch Chrome in kiosk mode pointing at Vercel PWA
start "" "C:\Program Files\Google\Chrome\Application\chrome.exe" ^
  --kiosk ^
  --kiosk-printing ^
  --disable-print-preview ^
  --no-first-run ^
  --disable-infobars ^
  --disable-session-crashed-bubble ^
  --disable-restore-session-state ^
  https://danbaiwa-restaurant-os.vercel.app
